# Copy this file to .env and fill in as needed. .env is git-ignored - never
# commit your API key. The agent reads these at startup (src/llm.py).

# Which backend to use: "ollama" (local, free, offline - the default) or
# "openai" (any OpenAI-compatible cloud endpoint).
LLM_BACKEND=ollama

# --- local Ollama (default) -------------------------------------------------
# Requires Ollama running locally and the model pulled: `ollama pull llama3.2:3b`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- OpenAI-compatible cloud (used only when LLM_BACKEND=openai) -------------
# Point base_url at any provider. Examples hosting the SAME llama3.2:3b, so your
# prompt behaviour carries over - just faster:
#   Together   base_url=https://api.together.xyz/v1         model=meta-llama/Llama-3.2-3B-Instruct-Turbo
#   OpenRouter base_url=https://openrouter.ai/api/v1        model=meta-llama/llama-3.2-3b-instruct
#   DeepInfra  base_url=https://api.deepinfra.com/v1/openai model=meta-llama/Llama-3.2-3B-Instruct
#   Groq       base_url=https://api.groq.com/openai/v1      model=openai/gpt-oss-20b
# (Groq's llama-3.1-8b-instant was decommissioned - it now 404s. gpt-oss-20b is a
# good cost/quality default; gpt-oss-120b is stronger but rate-limits harder on the
# free tier. Check live availability with GET {base_url}/models.)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-20b
